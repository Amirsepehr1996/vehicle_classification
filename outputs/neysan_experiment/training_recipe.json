{
  "architecture": "resnet18",
  "initialization": "imagenet",
  "trainable_layers": [
    "layer3",
    "layer4",
    "fc"
  ],
  "dropout": 0.25,
  "loss": "bce",
  "sampling": "balanced",
  "batch_size": 16,
  "epochs": 30,
  "layer3_lr": 3e-06,
  "layer4_lr": 1e-05,
  "fc_lr": 0.001,
  "weight_decay": 0.0001,
  "scheduler": "ReduceLROnPlateau",
  "scheduler_monitor": "validation_macro_f1",
  "batchnorm_running_stats": "fixed",
  "seed": 42,
  "image_size": 224,
  "mean": [
    0.485,
    0.456,
    0.406
  ],
  "std": [
    0.229,
    0.224,
    0.225
  ],
  "padding_color": [
    124,
    116,
    104
  ],
  "horizontal_flip_probability": 0.5,
  "color_jitter": {
    "brightness": 0.1,
    "contrast": 0.1,
    "saturation": 0.1
  },
  "training_images": 2615,
  "validation_images": 654,
  "checkpoint_rule": "macro_f1_then_accuracy_then_lower_loss",
  "human_check_threshold": 0.8,
  "confidence_method": "uncalibrated_sigmoid_score"
}